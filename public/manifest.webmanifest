{
  "id": "/",
  "name": "NCHAT — Visual prompt graph",
  "short_name": "NCHAT",
  "description": "A local-first, node-based prompt graph for LM Studio. Runs entirely on your machine, talks only to your own LM Studio server.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#0b0d13",
  "theme_color": "#0b0d13",
  "prefer_related_applications": false,
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "All workspaces",
      "short_name": "Home",
      "url": "./#/",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
